generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id
  name            String
  description     String
  price           Float
  priceDozen      Float?
  priceTwoDozen   Float?
  priceThreeDozen Float?
  priceBulk       Float?
  category        String
  image           String
  featured        Boolean  @default(false)
  colors          String?
  createdAt       DateTime @default(now())
  media           ProductMedia[]

  @@index([category])
}

model ProductMedia {
  id        String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model AdminUser {
  id           String   @id
  username     String   @unique
  passwordHash String
  salt         String
  createdAt    DateTime @default(now())
}
